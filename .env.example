# RiskShield AI Environment Configuration Example
# Copy this file to .env for local development or configure environment variables in your production environment (Vercel / Render / Railway / AWS).

# -----------------------------------------------------------------------------
# Frontend Configuration (Vite)
# -----------------------------------------------------------------------------
# Production URL of your deployed FastAPI backend (e.g. https://api.yourdomain.com)
# For local development, defaults to http://localhost:8000/api
VITE_API_URL=http://localhost:8000/api

# -----------------------------------------------------------------------------
# Backend Configuration (FastAPI)
# -----------------------------------------------------------------------------
# Server Port (default: 8000)
PORT=8000

# Secret key for signing JWT authentication tokens
JWT_SECRET=your_production_jwt_secret_key_here

# -----------------------------------------------------------------------------
# Redis & Celery Configuration (Optional / Distributed Task Queue)
# -----------------------------------------------------------------------------
# Redis connection URL for caching and task broker
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# -----------------------------------------------------------------------------
# Optional Bring-Your-Own-Key (BYOK) LLM Provider Credentials
# Note: Keys can also be configured dynamically in the Admin UI under AI Settings
# -----------------------------------------------------------------------------
GOOGLE_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
